BACKEND_URL=http://127.0.0.1:8000
# 호스팅의 보안 필터가 /_next/image 요청을 막는 경우에만 true로 설정한다.
NEXT_IMAGES_UNOPTIMIZED=false
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_CSRF_URL=/sanctum/csrf-cookie
# 백엔드 .env의 VAPID_PUBLIC_KEY와 같은 값을 넣는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 토스페이먼츠 개발자센터 > API 키에서 확인(비밀값 아님).
# 계약 전에는 공식 문서용 테스트 클라이언트 키를 그대로 쓸 수 있다: test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
# 결제위젯용(test_gck_...)이 아니라 API 개별 연동용(test_ck_...)이어야 한다. 백엔드 TOSS_PAYMENTS_SECRET_KEY와 짝을 맞춘다.
# 이 값은 빌드 시점에 번들에 박히므로 바꾸면 프론트를 다시 빌드해야 한다.
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
