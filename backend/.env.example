APP_NAME="Vegetable Garden Planner API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# 웹 루트 폴더명. 로컬은 public, 닷홈은 html이므로 운영 .env에서만 PUBLIC_DIR=html로 바꾼다.
PUBLIC_DIR=public

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google AI Studio(aistudio.google.com/apikey)에서 발급. 무료 등급 한도는 계정마다 달라
# aistudio.google.com/rate-limit에서 직접 확인한다(문서에 고정 수치가 없음).
# GEMINI_MODELS는 쉼표로 구분한 우선순위 목록 — 앞 모델이 할당량 초과(429)면 다음 모델로 자동 전환한다.
# 비워두면 아래와 동일한 기본값(config/services.php)을 그대로 쓴다 — 무료 등급이 있는
# 텍스트 생성 모델을 한도가 넉넉한 순서대로 최대한 나열해둔 것이라 보통 안 바꿔도 된다.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-pro-preview

# php artisan tinker --execute="print_r(Minishlink\WebPush\VAPID::createVapidKeys());" 로 생성한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# 토스페이먼츠 개발자센터 > API 키에서 발급. 웹훅 보안 키(64자리 hex)는 같은 메뉴에서 확인.
# 계약 전에는 공식 문서용 테스트 시크릿 키를 그대로 쓸 수 있다(자동결제/빌링 포함, 실제 출금 없음).
# 키 값과 근거는 docs/LOCAL_DEVELOPMENT.md의 "결제(토스페이먼츠) 테스트 키 설정" 참고.
# 이 값은 프론트의 NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY와 반드시 짝으로 맞춘다(섞으면 UNAUTHORIZED_KEY).
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_BASE_URL=https://api.tosspayments.com
# 웹훅 서명 검증용. 문서용 테스트 키에는 없으므로 비워 두면 웹훅 요청이 401로 거부된다(카드 등록·결제 흐름 자체는 정상 동작).
TOSS_PAYMENTS_WEBHOOK_SECURITY_KEY=

APP_LOCALE=ko
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ko_KR
BUSINESS_TIMEZONE=Asia/Seoul

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vegetable_garden_planner
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
